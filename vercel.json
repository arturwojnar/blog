{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev:11ty",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    {
      "source": "/trainings",
      "destination": "/offer",
      "permanent": true
    },
    {
      "source": "/trainings.html",
      "destination": "/offer",
      "permanent": true
    },
    {
      "source": "/oferta",
      "destination": "/offer",
      "permanent": true
    },
    {
      "source": "/oferta.html",
      "destination": "/offer",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/talks",
      "destination": "/talks.html"
    },
    {
      "source": "/offer",
      "destination": "/offer.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/((?!api|public|.*\\.).*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/public/(.*)\\.(webp|png|jpg|jpeg|gif|svg|ico|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}