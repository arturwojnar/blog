---
title: "Oferta — mentoring, konsultacje, warsztaty, odkrywanie produktu"
description: "Pomagam zespołom przejść przez trudne decyzje techniczne — DDD, optymalizacja SDLC, redukcja kosztów AWS, systemy danych. Mentoring, konsultacje i audyty, warsztaty, prelekcje oraz odkrywanie produktu."
layout: "../layouts/main.njk"
permalink: "/oferta.html"
ogUrl: "https://www.planthencode.com/oferta/"
---
{% set c = services.copy.pl %}

<div class="wrap">
  <div class="hero" style="padding-bottom:24px">
    <div class="eyebrow">plan <span class="c1">&gt;&gt;</span> then <span class="c1">&gt;&gt;</span> code</div>
    <h1>{{ c.title }}</h1>
    <p class="lede">{{ c.lede }}</p>
  </div>

  <section class="section">
    <div class="offer-grid">
      {% for s in services.services %}
        <article class="offer-card {% if loop.index0 % 2 == 1 %}alt{% endif %}">
          <div class="num">{{ s.num }}</div>
          <h2>{{ s.pl.title }}</h2>
          <div class="offer-meta">{{ s.pl.meta }}</div>
          <ul>
            {% for p in s.pl.points %}<li>{{ p }}</li>{% endfor %}
          </ul>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="section">
    <div class="kicker">Co mówią ludzie</div>
    <div class="reco-grid">
      {% for r in recommendations.items %}
        <figure class="reco">
          <blockquote>{{ r.quote }}</blockquote>
          <figcaption>
            <span class="reco-name">{{ r.name }}</span>
            <span class="reco-role">{{ r.role }}</span>
          </figcaption>
        </figure>
      {% endfor %}
    </div>
    <p class="reco-more">
      <a href="{{ recommendations.profileUrl }}" target="_blank" rel="noopener">{{ c.recoMore }} &gt;&gt;</a>
    </p>
  </section>

  <section class="section">
    <div class="guarantee-band">
      <div class="num">✓</div>
      <div>
        <h3>{{ c.guaranteeTitle }}</h3>
        <p>{{ c.guarantee }}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="band">
      <h2>{{ c.ctaTitle }}</h2>
      <p>{{ c.ctaText }}</p>
      <a class="btn btn-primary" href="/contact">{{ c.ctaButton }} <span class="a">&gt;&gt;</span></a>
      <div class="lang">🇵🇱 PL · <a href="{{ c.langSwitchUrl }}">{{ c.langSwitch }}</a></div>
    </div>
  </section>
</div>
