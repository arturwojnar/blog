<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <!-- Theme: set before first paint to avoid flash-of-wrong-theme (FOUC).
         Reads saved choice, else falls back to OS preference. -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (!t) {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", t);
          if (t === "dark") document.documentElement.classList.add("sl-theme-dark");
        } catch (e) {}
      })();
    </script>

    <title>{{ title }} | Plan Then Code</title>
    <meta name="description" content="{{ description }}">
    <meta
    name="author" content="Artur Wojnar"/> <!-- Open Graph / SEO -->
    <meta property="og:title" content="{{ title }}"/>
    <meta property="og:description" content="{{ description }}"/>
    <meta property="og:type" content="article"/>
    {% if ogUrl %}<meta property="og:url" content="{{ ogUrl }}"/>{% endif %}
    <meta
    property="og:site_name" content="Plan Then Code"/> <!-- Favicons -->
    <link rel="icon" href="/public/icons/favicon.ico" sizes="32x32"/>
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml"/>
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png"/>
    <link rel="manifest" href="/manifest.json"/>

    <!-- Perf: warm up the Shoelace CDN connection early (DNS+TLS) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net"/>

    <!-- Own CSS first (render path), self-hosted -->
    <link rel="stylesheet" href="/public/css/style.css"/>
    <!-- Prism theme self-hosted (syntax highlighting is build-time; only the theme CSS is needed) -->
    <link rel="stylesheet" href="/public/css/prism-okaidia.css"/>
    <!-- Shoelace themes from CDN, non-blocking (light + dark; dark applies via .sl-theme-dark) -->
    <link rel="stylesheet" media="print" onload="this.media='all'" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css"/>
    <link rel="stylesheet" media="print" onload="this.media='all'" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/dark.css"/>
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css"/>
    </noscript>

    <!-- Shoelace autoloader + our app JS: modules are deferred by default, non-blocking -->
    <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace-autoloader.js"></script>
    <script type="module" src="/public/js/main.js"></script>
  </head>
  <body>
    <header class="main-header">
      <nav class="main-nav">
        <div class="nav-menu">
          <a class="nav-link {% if page.url == '/' or page.url.startsWith('/about') %}active{% endif %}" href="/">💡
            <span class="main-link-text">About me</span>
          </a>
          <a class="nav-link {% if page.url.startsWith('/articles') %}active{% endif %}" href="/articles">📖
            <span class="main-link-text">Articles</span>
          </a>
          <a class="nav-link {% if page.url.startsWith('/offer') or page.url.startsWith('/oferta') %}active{% endif %}" href="/offer">🤝
            <span class="main-link-text">Offer</span>
          </a>
          <a class="nav-link {% if page.url.startsWith('/talks') %}active{% endif %}" href="/talks">🎤
            <span class="main-link-text">Speaker</span>
          </a>
          <a class="nav-link {% if page.url.startsWith('/contact') %}active{% endif %}" href="/contact">✉️
            <span class="main-link-text">Contact</span>
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Switch theme"
            aria-pressed="false">☾</button>
        </div>
        <div class="nav-newsletter-container">
          <form id="nav-newsletter-form" class="newsletter-form nav-newsletter-form">
            <sl-tooltip id="nav-newsletter-tooltip" placement="bottom" trigger="manual">
              <div slot="content" id="nav-newsletter-tooltip-content"></div>
              <input
                type="email"
                id="nav-newsletter-email"
                name="email"
                placeholder="Subscribe to newsletter"
                required
                aria-label="Email address for newsletter subscription"/>
            </sl-tooltip>
            <button type="submit" aria-label="Subscribe">✓</button>
          </form>
        </div>
        <a href="/" class="logo-link" aria-label="plan then code — home">
          <span class="wordmark">plan<svg class="wordmark-mark" width="30" height="22" viewBox="0 0 30 22" aria-hidden="true" focusable="false"><g fill="none" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="4,4 12,11 4,18" stroke="var(--accent)"/><polyline points="15,4 23,11 15,18" stroke="var(--secondary)"/><line x1="12" y1="11" x2="23" y2="11" stroke="var(--secondary)" stroke-width="1.8" opacity="0.7"/></g></svg>code</span>
        </a>
      </nav>
    </header>
    <main class="main-content">
      {{ content | safe }}
    </main>
    <footer>
      <div class="footer-social">
        <p>Contact with me by</p>
        <div class="social-icons">
          <a href="https://github.com/arturwojnar" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <sl-icon name="github" style="font-size: 2rem;"></sl-icon>
          </a>
          <a
            href="https://www.linkedin.com/in/artur-wojnar-a19349a6/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn">
            <sl-icon name="linkedin" style="font-size: 2rem;"></sl-icon>
          </a>
          <a href="mailto:contact@arturwojnar.com" aria-label="Email">
            <sl-icon name="envelope" style="font-size: 2rem;"></sl-icon>
          </a>
        </div>
      </div>
      <div class="newsletter-container">
        <form id="newsletter-form" class="newsletter-form">
          <sl-tooltip id="newsletter-tooltip" placement="top" trigger="manual">
            <div slot="content" id="newsletter-tooltip-content"></div>
            <input
              type="email"
              id="newsletter-email"
              name="email"
              placeholder="Subscribe to newsletter"
              required
              aria-label="Email address for newsletter subscription"/>
          </sl-tooltip>
          <button type="submit" aria-label="Subscribe">✓</button>
        </form>
      </div>
      &copy; {{ "now" | year() }} plan&gt;&gt;code · Artur Wojnar
    </footer>
  </body>
</html>