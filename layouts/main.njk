<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Theme: set before first paint to avoid flash-of-wrong-theme. -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem("theme") || "light";
          document.documentElement.setAttribute("data-theme", t);
          if (t === "dark") document.documentElement.classList.add("sl-theme-dark");
        } catch (e) {}
      })();
    </script>

    <title>{{ title }} | Plan Then Code</title>
    <meta name="description" content="{{ description }}" />
    <meta name="author" content="Artur Wojnar" />

    {# ---- Canonical URL ---- #}
    {% set canonicalUrl = canonical or ogUrl or (site.url + page.url) %}
    <link rel="canonical" href="{{ canonicalUrl }}" />

    {# ---- Resolve social share image (absolute URL) ---- #}
    {% if cover %}
      {% set socialImage = site.url + "/public" + cover %}
    {% elif ogImage %}
      {% set socialImage = site.url + ogImage %}
    {% else %}
      {% set socialImage = site.url + site.defaultImage %}
    {% endif %}

    {# ---- Page type: article body pages set layout to article.njk ---- #}
    {% set isArticle = (layout == "../layouts/article.njk") or (tags and date) %}

    <!-- Open Graph / SEO -->
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:site_name" content="Plan Then Code" />
    <meta property="og:image" content="{{ socialImage }}" />
    <meta property="og:locale" content="en_US" />
    {% if isArticle %}
      {% if date %}<meta property="article:published_time" content="{{ date | isoDate }}" />{% endif %}
      <meta property="article:author" content="{{ site.author.name }}" />
      {% if tags %}{% for tag in tags %}<meta property="article:tag" content="{{ tag }}" />
      {% endfor %}{% endif %}
    {% endif %}

    <!-- Favicons -->
    <link rel="icon" href="/public/icons/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Perf: warm up the Shoelace CDN connection early -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <!-- Own CSS first (render path), self-hosted -->
    <link rel="stylesheet" href="/public/css/colors.css" />
    <link rel="stylesheet" href="/public/css/app.css" />
    <!-- Prism theme self-hosted (syntax highlighting is build-time) -->
    <link rel="stylesheet" href="/public/css/prism-okaidia.css" />
    <!-- Shoelace themes from CDN, non-blocking -->
    <link
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css" />
    <link
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/dark.css" />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css" />
    </noscript>

    <!-- Shoelace autoloader + app JS: modules deferred by default -->
    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace-autoloader.js"></script>
    <script type="module" src="/public/js/main.js"></script>

    {# ---- Structured data (JSON-LD) ---- #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Plan Then Code",
      "url": "{{ site.url }}",
      "author": {
        "@type": "Person",
        "name": "{{ site.author.name }}",
        "url": "{{ site.author.url }}",
        "sameAs": [{% for s in site.author.sameAs %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}]
      }
    }
    </script>
    {% if isArticle %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "image": "{{ socialImage }}",
      "url": "{{ canonicalUrl }}",
      "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ canonicalUrl }}" },
      {% if date %}"datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ date | isoDate }}",{% endif %}
      {% if readingTime %}"timeRequired": "PT{{ readingTime }}M",{% endif %}
      {% if tags %}"keywords": "{{ tags | join(', ') }}",{% endif %}
      "author": {
        "@type": "Person",
        "name": "{{ site.author.name }}",
        "url": "{{ site.author.url }}",
        "sameAs": [{% for s in site.author.sameAs %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}]
      },
      "publisher": {
        "@type": "Person",
        "name": "{{ site.author.name }}"
      }
    }
    </script>
    {% endif %}
  </head>
  <body>
    <header class="site-header">
      <div class="hrow">
        <a class="brand" href="/" aria-label="plan then code — home">plan<svg
            class="mark"
            width="30"
            height="22"
            viewBox="0 0 30 22"
            aria-hidden="true"
            focusable="false">
            <g fill="none" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4,4 12,11 4,18" stroke="var(--accent)" />
              <polyline points="15,4 23,11 15,18" stroke="var(--secondary)" />
              <line
                x1="12"
                y1="11"
                x2="23"
                y2="11"
                stroke="var(--secondary)"
                stroke-width="1.8"
                opacity="0.7" />
            </g></svg>code</a>

        <button
          id="nav-toggle"
          type="button"
          class="nav-toggle"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="site-nav">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>

        <nav class="site-nav" id="site-nav">
          <a href="/" class="{% if page.url == '/' or page.url.startsWith('/about') %}active{% endif %}">About me</a>
          <a href="/articles" class="{% if page.url.startsWith('/articles') %}active{% endif %}">Articles</a>
          <a href="/offer" class="{% if page.url.startsWith('/offer') %}active{% endif %}">Offer</a>
          <a href="/talks" class="{% if page.url.startsWith('/talks') %}active{% endif %}">Speaker</a>
          <a href="/contact" class="btn btn-primary nav-cta{% if page.url.startsWith('/contact') %} active{% endif %}">Book a call</a>

          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Switch theme"
            aria-pressed="false">☾</button>
        </nav>
      </div>
    </header>

    <main class="main-content{% if bodyClass %} {{ bodyClass }}{% endif %}">{{ content | safe }}</main>

    <footer class="site-footer">
      <div class="social-icons">
        <a href="https://github.com/arturwojnar" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <sl-icon name="github" style="font-size: 1.6rem;"></sl-icon>
        </a>
        <a
          href="https://www.linkedin.com/in/artur-wojnar-a19349a6/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn">
          <sl-icon name="linkedin" style="font-size: 1.6rem;"></sl-icon>
        </a>
        <a href="mailto:contact@arturwojnar.com" aria-label="Email">
          <sl-icon name="envelope" style="font-size: 1.6rem;"></sl-icon>
        </a>
        <a href="https://cal.eu/arturwojnar" target="_blank" aria-label="Calendar">
          <sl-icon name="calendar-day" style="font-size: 1.6rem;"></sl-icon>
        </a>
      </div>

      <form id="newsletter-form" class="nav-newsletter" style="justify-content:center;margin-bottom:14px">
        <sl-tooltip id="newsletter-tooltip" placement="top" trigger="manual">
          <div slot="content" id="newsletter-tooltip-content"></div>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="Subscribe to newsletter"
            required
            aria-label="Email address for newsletter subscription" />
        </sl-tooltip>
        <button type="submit" aria-label="Subscribe">✓</button>
      </form>

      &copy; {{ "now" | year() }} plan<span class="c1">&gt;&gt;</span>code · Artur Wojnar
    </footer>
  </body>
</html>
