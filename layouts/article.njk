---
layout: "./main.njk"
eleventyComputed:
  ogUrl: "https://www.planthencode.com/articles/{{ page.fileSlug }}/"
---
{% from "collab-cta.njk" import collabCta %}

<div class="wrap article">
  <article>
    <like-container slug="{{ slug or page.fileSlug }}"></like-container>

    {% set category = tags | categoryOf %}
    {% if category %}
      <a class="article-category" href="/articles#{{ category }}">{{ category | categoryLabel }}</a>
    {% endif %}

    <h1 class="article-title">{{ title }}</h1>

    {% set topics = tags | topicTags %}
    {% if topics.length %}
      <div class="article-tags">
        {% for tag in topics %}
          <span class="tag">{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}

    <div class="article-body">
      {{ content | safe }}
    </div>
  </article>
</div>

<div class="wrap">
  {{ collabCta("en") }}

  <section class="section">
    <div class="prod">
      <div class="ico">🫒</div>
      <div style="flex:1">
        <h3>HermesJS 🫒🌿</h3>
        <p>
          Reliable messaging for Node.js / TypeScript. <em>Hermes PostgreSQL</em> (logical
          replication) &amp; <em>Hermes MongoDB</em> (change streams) implement the
          <strong>Outbox pattern</strong> — span a DB transaction over persisting an entity and
          publishing a message. A library, not a framework.
        </p>
      </div>
      <a href="https://docs.hermesjs.tech/" target="_blank" rel="noopener">Docs &gt;&gt;</a>
    </div>
  </section>
</div>
